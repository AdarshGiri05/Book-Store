<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body style="background: #f2f2f2; margin: 0; font-family: Arial, sans-serif;">

    <%- include('includes/nav.ejs') %>

    <main style="margin-left: 30px; margin-top: 18px; margin-bottom: 30px;">
        <h1 style="font-size: 30px; font-weight: 700; margin: 0 0 30px;">Contact Page</h1>

        <% if (success) { %>
            <div style="margin: 0 auto 18px auto; padding: 8px 12px; background: #e6f9ee; border: 1px solid #2eaa5a; color: #146b3b; border-radius: 6px; width: 420px; max-width: 90vw; font-size: 18px; text-align: center; box-sizing: border-box;">
                Message sent successfully.
            </div>
        <% } %>

        <form action="/contact" method="POST" style="display: inline-block;">

            <div style="display: flex; align-items: center; margin-bottom: 14px;">
                <label style="display: inline-block; width: 180px; font-size: 22px; margin-right: 16px;">Name</label>
                <input type="text" name="name" required
                       style="width: 520px; max-width: 90vw; border: 1px solid black; height: 32px; background: white; padding: 0 8px; box-sizing: border-box;">
            </div>

            <div style="display: flex; align-items: center; margin-bottom: 14px;">
                <label style="display: inline-block; width: 180px; font-size: 22px; margin-right: 16px;">Email</label>
                <input type="email" name="email" required
                       style="width: 520px; max-width: 90vw; border: 1px solid black; height: 32px; background: white; padding: 0 8px; box-sizing: border-box;">
            </div>

            <div style="display: flex; align-items: center; margin-bottom: 14px;">
                <label style="display: inline-block; width: 180px; font-size: 22px; margin-right: 16px;">Mobile Number</label>
                <input type="text" name="mob" required
                       style="width: 520px; max-width: 90vw; border: 1px solid black; height: 32px; background: white; padding: 0 8px; box-sizing: border-box;">
            </div>

            <div style="display: flex; align-items: flex-start; margin-bottom: 18px;">
                <label style="display: inline-block; width: 180px; font-size: 22px; margin-right: 16px; margin-top: 6px;">Message</label>
                <textarea name="message" required rows="4"
                          style="width: 520px; max-width: 90vw; border: 1px solid black; background: white; padding: 8px; box-sizing: border-box; resize: vertical;"></textarea>
            </div>

            <button type="submit"
                    style="border: 1px solid black; background: #f5f5f5; padding: 8px 18px; font-size: 18px; cursor: pointer;">
                Send
            </button>
        </form>
    </main>

    <%- include('includes/footer.ejs') %>

</body>
</html>