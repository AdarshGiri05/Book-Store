<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart | Bookstore</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f7f8fa;
            color: #333;
        }

        .cart-item {
            transition: box-shadow 0.2s ease;
        }

        .cart-item:hover {
            box-shadow: 0 5px 14px rgba(0, 0, 0, 0.07);
        }

        .cart-btn {
            transition: background-color 0.2s ease;
        }
    </style>
</head>

<body>

    <%- include('includes/nav.ejs') %>

    <main class="max-w-5xl mx-auto px-4 py-8 md:py-10">

        <div class="mb-7">
            <h1 class="text-3xl font-bold text-gray-800">My Cart</h1>
            <p class="mt-2 text-sm text-gray-500">
                Review your selected books before continuing.
            </p>
        </div>

        <% if (!cartItems || cartItems.length === 0) { %>

            
            <div class="bg-white border border-gray-200 rounded-lg p-8 md:p-12 text-center">

                <div class="text-5xl mb-4">📚</div>

                <h2 class="text-xl font-bold text-gray-800">
                    Your cart is empty
                </h2>

                <p class="text-gray-500 text-sm mt-2">
                    You haven't added any books to your cart yet.
                </p>

                <a href="/books"
                   class="cart-btn inline-block mt-5 bg-[#2458d3] hover:bg-[#354f52] text-white font-semibold py-2.5 px-5 rounded-md text-sm">
                    Browse Books
                </a>

            </div>

        <% } else { %>

           
            <div class="space-y-4">

                <% cartItems.forEach(item => { %>

                    <div class="cart-item bg-white border border-gray-200 rounded-lg p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">

                        
                        <div class="flex items-center gap-4 min-w-0">

                            <div class="w-20 h-24 shrink-0 flex items-center justify-center bg-gray-50 border border-gray-200 rounded-md p-1">
                                <img
                                    src="/<%= item.image %>"
                                    alt="<%= item.name || item.title %>"
                                    class="max-w-full max-h-full object-contain">
                            </div>

                            <div>
                                <h2 class="text-base md:text-lg font-bold text-gray-800">
                                    <%= item.name || item.title %>
                                </h2>

                                <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden bg-white w-fit mt-2">
                                    <a href="/cart/decrease/<%= item._id %>"
                                       aria-label="Decrease quantity of <%= item.name || item.title %>"
                                       class="cart-btn px-3 py-1 text-lg font-semibold text-gray-700 hover:bg-gray-100">−</a>
                                    <span class="min-w-10 text-center text-gray-800 font-semibold"
                                          aria-label="Quantity"><%= item.quantity %></span>
                                    <a href="/cart/increase/<%= item._id %>"
                                       aria-label="Increase quantity of <%= item.name || item.title %>"
                                       class="cart-btn px-3 py-1 text-lg font-semibold text-gray-700 hover:bg-gray-100">+</a>
                                </div>

                                <p class="text-sm font-semibold text-[#52796f] mt-1">
                                    ₹<%= item.price %> each
                                </p>
                            </div>

                        </div>

                       
                        <div class="w-full sm:w-auto flex flex-row sm:flex-col justify-between sm:items-end items-center gap-3">

                            <p class="text-base font-bold text-gray-800">
                                Subtotal: ₹<%= Number(item.price) * Number(item.quantity || 1) %>
                            </p>

                            <div class="flex items-center gap-2">

                                <a href="/cart/remove/<%= item._id %>"
                                   class="cart-btn bg-red-50 hover:bg-red-100 border border-red-200 text-red-600 font-semibold py-1.5 px-3 rounded-md text-sm">
                                    Remove
                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

          
            <div class="bg-white border border-gray-200 rounded-lg p-5 md:p-6 mt-6">

                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">

                    <div>
                        <p class="text-sm text-gray-500">
                            Total Amount
                        </p>

                        <h2 class="text-2xl font-bold text-gray-800 mt-1">
                            ₹<%= total %>
                        </h2>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">

                        <a href="/books"
                           class="cart-btn text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 px-4 rounded-md text-sm">
                            Continue Shopping
                        </a>

                        <a href="/contact"
                           class="cart-btn text-center bg-[#52796f] hover:bg-[#354f52] text-white font-semibold py-2.5 px-4 rounded-md text-sm">
                            Proceed to Contact →
                        </a>

                    </div>

                </div>

            </div>

        <% } %>

    </main>

    <%- include('includes/footer.ejs') %>

</body>
</html>