<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 text-gray-800">
    <%- include('includes/nav.ejs') %>

    <div class="max-w-5xl mx-auto px-4 py-10">
        <h1 class="text-3xl font-bold mb-6">Your Cart</h1>

        <% if (!cartItems || cartItems.length === 0) { %>
            <div class="bg-white rounded-xl shadow-md p-8 text-center">
                <p class="text-xl font-semibold text-gray-700">Your cart is empty.</p>
                <a href="/books" class="inline-block mt-5 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md">
                    Continue Shopping
                </a>
            </div>
        <% } else { %>
            <div class="space-y-4">
                <% cartItems.forEach(item => { %>
                    <div class="bg-white rounded-xl shadow-md p-4 flex flex-col md:flex-row justify-between items-center gap-4">
                        <div class="flex items-center gap-4">
                            <img src="/<%= item.image %>" alt="<%= item.name || item.title %>" class="w-20 h-20 object-contain rounded-lg bg-gray-50 border border-gray-200 p-2">
                            <div>
                                <h2 class="text-xl font-bold"><%= item.name || item.title %></h2>
                                <p class="text-gray-600">Quantity: <%= item.quantity %></p>
                            </div>
                        </div>
                        <div class="text-right flex flex-col items-end gap-3">
                            <div>
                                <p class="text-lg font-semibold">₹<%= item.price %> each</p>
                                <p class="text-gray-600">Subtotal: ₹<%= Number(item.price) * Number(item.quantity || 1) %></p>
                            </div>
                            <div class="flex gap-2">
                                <a href="/cart/decrease/<%= item._id %>" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-1.5 px-3 rounded-md text-sm">
                                    -1
                                </a>
                                <a href="/cart/remove/<%= item._id %>" class="bg-red-500 hover:bg-red-600 text-white font-semibold py-1.5 px-3 rounded-md text-sm">
                                    Remove
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="bg-white rounded-xl shadow-md p-6 mt-6 flex flex-col md:flex-row justify-between items-center gap-4">
                <h2 class="text-2xl font-bold">Total: ₹<%= total %></h2>
                <div class="flex gap-3">
                    <a href="/books" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-md">
                        Keep Shopping
                    </a>
                    <a href="/contact" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md">
                        Proceed to Contact
                    </a>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('includes/footer.ejs') %>
</body>
</html>
